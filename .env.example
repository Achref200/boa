# ─── Database ────────────────────────────────────────────────────────────────
# Hostinger: create the database and user in hPanel, then use the credentials it
# shows. The host is usually "localhost" for a Node app on the same plan.
DATABASE_URL="mysql://user:password@localhost:3306/boa"

# ─── Application ─────────────────────────────────────────────────────────────
# Public origin, no trailing slash. Used for canonical URLs, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL="https://boacosmetic.tn"
NODE_ENV="production"

# 32+ random bytes, base64. Generate with: openssl rand -base64 48
# Rotating this invalidates every signed cookie (sessions survive: they are
# database-backed, the secret only signs the cart token and CSRF tokens).
APP_SECRET="change-me"

# ─── Media ───────────────────────────────────────────────────────────────────
# "local" writes under public/uploads. "s3" requires the S3_* values below and
# is the path to take if the host redeploys into a clean tree.
MEDIA_DRIVER="local"
MEDIA_MAX_BYTES="5242880"
# S3_ENDPOINT=""
# S3_REGION=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL=""

# ─── Payments ────────────────────────────────────────────────────────────────
# Comma-separated list of enabled providers. "cod", "cop", "bank_transfer" work
# with no configuration. An online gateway is added here once BOA has an account.
PAYMENT_PROVIDERS="cod,cop,bank_transfer"
# PAYMENT_GATEWAY_KEY=""
# PAYMENT_GATEWAY_SECRET=""
# PAYMENT_WEBHOOK_SECRET=""

# ─── Mail (optional in v1) ───────────────────────────────────────────────────
# Left unset, the app logs what it would have sent instead of failing.
# SMTP_URL="smtp://user:pass@smtp.hostinger.com:587"
# MAIL_FROM="BOA Cosmetic <contact@boacosmetic.tn>"

# Public base URL for media. Empty means media is served from /uploads by the
# local driver. Set this when MEDIA_DRIVER=s3 (it is public by nature — it ends
# up in every <img> tag — which is why it carries the NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_MEDIA_BASE_URL=""

# ─── Seed / test administrator ───────────────────────────────────────────────
# `npm run db:seed` creates the first admin account. Left unset, it generates a
# random password and prints it once — safe for a real deployment, but it means
# the seeded password can never match the credentials tests/e2e/admin.spec.ts
# signs in with, so the admin E2E journeys fail against a freshly seeded
# database. Set both locally so seeding and the E2E suite agree.
# Never reuse these values in production; change the password after first
# sign-in.
SEED_ADMIN_EMAIL="admin@boacosmetic.tn"
SEED_ADMIN_PASSWORD="boa-dev-password-2026"
